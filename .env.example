# US site (/us) runtime config. Copy to .env.local for local dev; set on Vercel for production.
# CTAs are disabled until NEXT_PUBLIC_APGO_US_LINKS_READY=true AND the product's LINK_READY=true
# AND the URL matches https://*.amazon.com/.
NEXT_PUBLIC_APGO_US_LINKS_READY=false
NEXT_PUBLIC_APGO_US_VIDEO_READY=false
NEXT_PUBLIC_APGO_US_SHOW_ORIGIN=true
NEXT_PUBLIC_APGO_US_RANK_SOURCE=By retail sales volume in Taiwan
# Optional override; blank or omitted uses the public APGO support address below.
NEXT_PUBLIC_APGO_US_SUPPORT_EMAIL=services@apgo.com.tw

# Analytics. GA4 is configured inside the GTM container, so no measurement ID goes here.
# Set BOTH of these only in the Vercel Production environment: leaving them unset on
# Preview and Development is what keeps test traffic out of GA4.
# NEXT_PUBLIC_* values are inlined at build time, so a change needs a redeploy.
NEXT_PUBLIC_APGO_US_ANALYTICS_READY=false
NEXT_PUBLIC_APGO_US_GTM_ID=

# Amazon Attribution / Associates query string appended to every product URL.
# Raw query-string form, no leading "?", e.g. maas=maas_adg_abc123&ref_=aa_maas
# Supports {sku} and {placement} tokens, e.g. ascsubtag=us-{sku}-{placement}.
# Must stay deterministic: no timestamps or random values, or SSR and hydration
# produce different hrefs. A per-product value overrides the shared one.
NEXT_PUBLIC_APGO_US_AMAZON_ATTRIBUTION=

NEXT_PUBLIC_APGO_US_D204_AMAZON_URL=
NEXT_PUBLIC_APGO_US_D204_LINK_READY=false
NEXT_PUBLIC_APGO_US_D204_WASH_RESISTANCE=
NEXT_PUBLIC_APGO_US_D204_AMAZON_ATTRIBUTION=

NEXT_PUBLIC_APGO_US_D215_AMAZON_URL=
NEXT_PUBLIC_APGO_US_D215_LINK_READY=false
NEXT_PUBLIC_APGO_US_D215_WASH_RESISTANCE=
NEXT_PUBLIC_APGO_US_D215_AMAZON_ATTRIBUTION=
