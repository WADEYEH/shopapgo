# US site (/us) runtime config. Copy to .env.local for local dev; set on the host for production.
NEXT_PUBLIC_APGO_US_VIDEO_READY=false
NEXT_PUBLIC_APGO_US_SHOW_ORIGIN=true
NEXT_PUBLIC_APGO_US_RANK_SOURCE=By retail sales volume in Taiwan
# Optional override; blank or omitted uses the public APGO support address below.
NEXT_PUBLIC_APGO_US_SUPPORT_EMAIL=services@apgo.com.tw

# Analytics. GA4 is configured inside the GTM container, so no measurement ID goes here.
# Set BOTH of these only in the production environment: leaving them unset on
# Preview and Development is what keeps test traffic out of GA4.
# NEXT_PUBLIC_* values are inlined at build time, so a change needs a redeploy.
NEXT_PUBLIC_APGO_US_ANALYTICS_READY=false
NEXT_PUBLIC_APGO_US_GTM_ID=
# The Meta Pixel needs no setting: public/js/meta-pixel.js has the one dataset id and runs only on the store hostnames.
# Global Privacy Control (D46): "false" stops honouring it; blank or omitted honours it (no Meta for those browsers).
NEXT_PUBLIC_APGO_US_HONOR_GPC=

NEXT_PUBLIC_APGO_US_D204_WASH_RESISTANCE=
NEXT_PUBLIC_APGO_US_D215_WASH_RESISTANCE=

# Single site (lib/us/routes.js): "true" only for builds served together with the store pages by the store Worker.
# commerce/scripts/build-site.mjs sets it for the test site and for www (since the 10/16 cutover). On: Shop and the cart in the
# header, store and policy links in the footer, named product URLs. Off: product buttons go to /products/d204|d215.
NEXT_PUBLIC_APGO_US_SINGLE_SITE=false
